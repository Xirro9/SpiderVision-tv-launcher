<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- A TV app: no touchscreen needed, leanback required. -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="true" />

    <!-- Only used to fetch NextDNS statistics once linked (see docs/NEXTDNS.md). -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Package visibility: only apps that expose a TV or regular launcher entry. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:banner="@drawable/banner"
        android:icon="@drawable/app_icon"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@style/Theme.SpiderVision">

        <!-- Normal TV app entry only. HOME is deliberately NOT claimed (Phase 6, needs approval). -->
        <activity
            android:name=".MainActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|uiMode"
            android:exported="true"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Link/unlink NextDNS from a PC over ADB only: the sender must hold WRITE_SECURE_SETTINGS,
             which the ADB shell has and ordinary apps cannot get. -->
        <receiver
            android:name=".network.ProvisionReceiver"
            android:exported="true"
            android:permission="android.permission.WRITE_SECURE_SETTINGS" />
    </application>
</manifest>
