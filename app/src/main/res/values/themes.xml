<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Solid background, no window transitions: the launcher should appear instantly. -->
    <style name="Theme.SpiderVision" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowContentTransitions">false</item>
    </style>
    <color name="bg">#111216</color>
</resources>
